#version 450
#extension GL_GOOGLE_include_directive : require

/// cloud_weather.comp
/// The clouds' weather map for this frame, baked into a texture around the
/// camera: how much of the sky is cloud at each point, and of what kind. The
/// map is three noises, and every step of every ray in the clouds' march reads
/// it; baked here, a step reads it once instead of three times.
///
/// Dispatch: ceil(size / 8)^2 workgroups.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "sky/clouds.glsl"

// The map's constants block, of which this reads only the clouds.
layout(binding = 256) uniform CloudWeatherConstants
{
    CloudConstants clouds;
} uWeather;

// NVRHI's Vulkan backend offsets UAV bindings by +384.
layout(binding = 384, rgba8) uniform writeonly image2D uWeatherMap;

void main()
{
    ivec2 size  = imageSize(uWeatherMap);
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(texel, uvec2(size))))
    {
        return;
    }
    CloudConstants c = uWeather.clouds;
    vec2 across = c.weatherArea.xy + (vec2(texel) + 0.5 - 0.5 * vec2(size)) * c.weatherArea.w;
    CloudWeather weather = CloudWeatherFromNoise(c, c.low, across, c.weatherArea.w);
    imageStore(uWeatherMap, ivec2(texel), vec4(weather.coverage, weather.kind, 0.0, 0.0));
}
