<!-- The game's look. A screen names these styles and tokens rather than
     colours, so a mode switched restyles every screen at once.

     Two modes: dark, the everyday one, and high_contrast, with plainer edges
     and stronger colours for a player who needs them. The pause menu's
     Contrast button switches between them. -->
<theme>
  <palette mode="dark"
           scrim="rgbf(0, 0, 0, 0.55)" edge_width="2"
           ink="#ffffff" accent="#e63319" accent_hover="#ff6a4d" accent_pressed="#a02010"
           accent_ink="#ffffff" ghost_hover="#ffffff26" ghost_pressed="#ffffff4d" focus="#ffd23c"
           frame="frames:panel" />
  <palette mode="high_contrast"
           scrim="#000000e6" edge_width="4"
           ink="#ffffff" accent="#ffd23c" accent_hover="#ffe680" accent_pressed="#c9a000"
           accent_ink="#000000" ghost_hover="#ffffff4d" ghost_pressed="#ffffff80" focus="#00e5ff"
           frame="frames:panel_contrast" />

  <!-- A box that holds a menu: its frame, from ui/frames.amsp, is its fill
       and its edge, and keeps its corners however large the box grows. -->
  <style name="panel" background_image="$frame" text_color="$ink" />

  <!-- What every menu button shares. The two after it say how one is
       coloured: filled for the action a player most likely wants, outlined
       for the rest. -->
  <style name="menu_button" padding="28 10 28 10" text_size="28"
         corner_radius="10" corner_style="rounded"
         focused:border_width="3" focused:border_color="$focus" />
  <style name="primary_button" extends="menu_button"
         background="$accent" text_color="$accent_ink"
         hover:background="$accent_hover" pressed:background="$accent_pressed" />
  <style name="secondary_button" extends="menu_button"
         border_width="$edge_width" border_color="$ink"
         hover:background="$ghost_hover" pressed:background="$ghost_pressed" />

  <!-- Every built-in control wears the style named after it, under any style
       it names itself. These hold the look each has when nothing else says,
       part by part: change one here to change every control of its kind.
       What a control decides itself, such as how wide a slider's fill is and
       how big a scroll bar is, is not written here. -->
  <style name="control" focused:outline_width="3" focused:outline_gap="3"
         focused:outline_color="#ffffff" />
  <style name="button" extends="control" />
  <style name="toggle" extends="control"
         track:width="grow" track:height="grow" track:background="rgbf(0.24, 0.26, 0.32)"
         track:on:background="rgbf(0.9, 0.2, 0.1)"
         track:corner_radius="50%" track:corner_style="rounded"
         knob:width="28" knob:height="28" knob:background="rgbf(0.92, 0.93, 0.96)"
         knob:corner_radius="50%" knob:corner_style="rounded" />
  <style name="slider" extends="control"
         track:width="grow" track:height="6" track:background="rgbf(0.24, 0.26, 0.32)"
         track:corner_radius="50%" track:corner_style="rounded"
         fill:height="6" fill:background="rgbf(0.9, 0.2, 0.1)"
         fill:corner_radius="50%" fill:corner_style="rounded"
         thumb:width="16" thumb:height="grow" thumb:background="rgbf(0.92, 0.93, 0.96)"
         thumb:corner_radius="50%" thumb:corner_style="rounded" />
  <style name="stepped_slider" extends="slider" />
  <style name="scroll" extends="control"
         track:background="rgbf(0.24, 0.26, 0.32)" track:corner_radius="50%" track:corner_style="rounded"
         thumb:background="rgbf(0.92, 0.93, 0.96)" thumb:corner_radius="50%" thumb:corner_style="rounded" />
  <style name="text_field" extends="control" caret_color="rgbf(0.95, 0.96, 0.98)"
         selection_color="rgbf(0.22, 0.38, 0.72)" />
</theme>
