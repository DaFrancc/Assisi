<!-- The pause menu. Escape shows it, Resume or Back closes it, Quit ends the
     game, and Contrast switches the theme between its two modes. While it is
     up it takes the pointer and the keys, and the world stops.

     How it looks is the theme's, ui/Default.amth: the file names a style for
     each part and says only what is particular to this menu. -->
<screen input="consume" beneath="hide" pause="true" sort="menu"
        needs="PauseMenu"
        align="center center" background="$scrim" blocks_pointer="true">

  <column name="panel" style="panel" width="420" padding="32" gap="20" align="center start">

    <!-- Every word comes from the table ui/pause.csv, and the icon beside the
         title from the sheet ui/icons.amsp, coloured by the theme. -->
    <row name="heading" width="grow" gap="16" align="start center">
      <image name="icon" sprite="icons:pause" tint="$accent" />
      <text name="title" width="grow" text_size="48">#pause:title</text>
    </row>

    <row name="buttons" width="grow" gap="20" align="center center">

      <!-- Resume goes through an event, so the system that closes the menu
           also plays its click. -->
      <button name="resume" style="primary_button" on_click="Game::ResumeRequested"
              focus="true">#pause:resume</button>

      <!-- Quit leaves the UI, so it goes through an event a system answers. -->
      <button name="quit" style="secondary_button"
              on_click="Assisi::App::QuitRequested">#pause:quit</button>

    </row>

    <!-- Game code switches the mode, which no file can. -->
    <button name="contrast" style="secondary_button" width="grow"
            on_click="Game::ContrastToggled">#pause:contrast</button>
  </column>
</screen>
