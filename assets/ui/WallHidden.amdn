<!-- A label the wall in levels/Test.alvl hides. Its WorldWidget has
     blocked="Hides": it shows only while nothing stands between the camera and
     it, as a nameplate does. Walk round the wall to see it. -->
<screen sort="hud" attach="center end">

  <column style="panel" padding="10 6 10 6" align="center center">
    <text text_size="16">Hidden behind walls</text>
  </column>

</screen>
