<!-- The heads-up display: a player's speed and velocity in the bottom right,
     read from the player's CharacterState every frame with no code. The Hud
     system gives each player one, with that player as its context; everything
     shown here is the file's. -->
<screen sort="hud" align="end end" padding="24">

  <!-- TuningSettings is on no entity, so these read it without the context.
       ui/Tuning.amdn is what changes it. -->
  <column name="readout" style="panel" padding="16" gap="4" align="end center"
          visible="{TuningSettings.showHud}">
    <text name="speed" text_size="28">{CharacterState.groundSpeed:.1f} m/s</text>
    <text name="velocity" text_size="18">{CharacterState.velocity:.1f}</text>

    <!-- Shown only while the player sprints. -->
    <text name="sprinting" text_size="18" visible="{CharacterState.sprinting}">Sprinting</text>

    <text name="difficulty" text_size="18">{TuningSettings.difficulty:#tuning:difficulty}</text>
  </column>

</screen>
