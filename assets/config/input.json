{
  "version": 1,
  "type": "InputBindings",
  "actions": {
    "Crouch":       ["LeftControl"],
    "Jump":         ["Space"],
    "LookMode":     ["RightMouse"],
    "MoveBackward": ["S", "DownArrow"],
    "MoveDown":     ["LeftControl"],
    "MoveForward":  ["W", "UpArrow"],
    "MoveLeft":     ["A", "LeftArrow"],
    "MoveRight":    ["D", "RightArrow"],
    "MoveUp":       ["Space"],
    "Select":       ["LeftMouse"],
    "Sprint":       ["LeftShift"],
    "UiAccept":     ["Enter"],
    "UiBack":       ["Escape"],
    "UiDown":       ["DownArrow"],
    "UiLeft":       ["LeftArrow"],
    "UiNext":       ["Tab"],
    "UiRight":      ["RightArrow"],
    "UiUp":         ["UpArrow"]
  }
}
