{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ASSISI_WARNINGS_AS_ERRORS": "OFF",
        "ASSISI_ENABLE_FAST_MATH": "ON",
        "ASSISI_ENABLE_SANITIZERS": "OFF",
        "ASSISI_SANITIZER_SET": "address;undefined"
      }
    },

    {
      "name": "msvc-debug",
      "inherits": "base",
      "description": "Windows + MSVC + Debug (unoptimized, full symbols)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "msvc-dev",
      "inherits": "base",
      "description": "Windows + MSVC + Development (optimized, partial symbols)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "msvc-ship",
      "inherits": "base",
      "description": "Windows + MSVC + Shipping (fully optimized, no debug info)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "gcc-debug",
      "inherits": "base",
      "description": "Linux + GCC + Debug (unoptimized, full symbols)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-dev",
      "inherits": "base",
      "description": "Linux + GCC + Development (optimized, partial symbols)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "gcc-ship",
      "inherits": "base",
      "description": "Linux + GCC + Shipping (fully optimized, no debug info)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },

    {
      "name": "clang-debug",
      "inherits": "base",
      "description": "Linux + Clang + Debug (unoptimized, full symbols)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-dev",
      "inherits": "base",
      "description": "Linux + Clang + Development (optimized, partial symbols)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-ship",
      "inherits": "base",
      "description": "Linux + Clang + Shipping (fully optimized, no debug info)",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-debug",  "configurePreset": "msvc-debug"  },
    { "name": "msvc-dev",    "configurePreset": "msvc-dev"    },
    { "name": "msvc-ship",   "configurePreset": "msvc-ship"   },

    { "name": "gcc-debug",   "configurePreset": "gcc-debug"   },
    { "name": "gcc-dev",     "configurePreset": "gcc-dev"     },
    { "name": "gcc-ship",    "configurePreset": "gcc-ship"    },

    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-dev",   "configurePreset": "clang-dev"   },
    { "name": "clang-ship",  "configurePreset": "clang-ship"  }
  ]
}