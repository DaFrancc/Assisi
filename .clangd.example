# clangd configuration template.
#
# .clangd is gitignored because CompilationDatabase is per-machine: it must
# point at a build directory that exists on THIS box. Copy this file to .clangd
# and set CompilationDatabase to the preset you build.
#
#   cp .clangd.example .clangd     # then edit CompilationDatabase below
#
# The database is generated by CMake (CMAKE_EXPORT_COMPILE_COMMANDS=ON, set in
# every preset) at out/build/<preset>/compile_commands.json. Configure a preset
# first, e.g.  cmake --preset msvc-debug  (Windows)  or  clang-debug  (Linux).

CompileFlags:
  # Windows / MSVC:
  CompilationDatabase: out/build/msvc-debug
  # Linux / Clang, use instead:
  # CompilationDatabase: out/build/clang-debug
  # Linux / GCC, use instead:
  # CompilationDatabase: out/build/gcc-debug

  # clangd drops the /std flag when it infers a command for a header from a .cpp,
  # which hides library features (e.g. std::apply). Pin the newest standard the
  # project uses: targets mix c++17 and c++latest, and some code needs C++23
  # (std::expected), so the newest is the safe superset. A lower value would
  # *downgrade* the c++latest TUs, since this flag is appended (last wins).
  #
  # MSVC-style database (Windows) uses the /std: spelling:
  Add: [/std:c++latest]
  # GCC/Clang database (Linux) uses the -std= spelling instead:
  # Add: [-std=c++2b]
