# CMake build output
out/
build/
CMakeFiles/
CMakeCache.txt

# Local convenience symlinks to the built executables (see shortcuts/)
shortcuts/
cmake_install.cmake

# Conan
.conan/

# Python (reflectgen tooling)
__pycache__/
*.pyc

# Compiled output
*.exe
*.dll
*.lib
*.a
*.so
*.o
*.obj
*.pdb
*.ilk
*.exp

# clangd LSP config — per-machine (points at the local build's compile DB).
# Copy .clangd.example to .clangd and repoint CompilationDatabase for your OS.
.clangd

# VS / Rider / CLion
.vs/
.idea/
*.user
*.suo
*.sln.docstates
*.VC.db
*.VC.opendb
*.cache

# Logs and crash artifacts. Both are written under the user root, which is the
# exe directory by default — so running from the repo root leaves them here.
*.log
crash-*.txt
*.dmp

# Runtime-generated user state (written under the user root at runtime; the
# repo-root copies are artifacts of running the app from the repo root). The
# app falls back to defaults when these are absent.
imgui.ini
options.json

# Scratch / experiments
sample/

# AI
CLAUDE.md
.claude/

# Art
logo/

# Screenshots kept while working on something — before/after comparisons, a bug
# caught in the act. They are about one session, and the tracker is where any of
# them that still mean something get attached.
pics/

# Model assets — heavy binary art (glTF .bin + textures), kept local only.
assets/models/

# Compiled shaders, which the build writes beside the GLSL they come from. The
# asset tree is the only one, so build outputs land in it rather than in a staged
# copy; they are reproducible from the source beside them and belong to no clone
# but this one. The .aast is the id the asset database mints for each on first
# load — an id for a derived file, regenerated with it. The .tmp is a compiled
# shader mid-rename, present only while a build is running.
assets/**/*.spv
assets/**/*.spv.aast
assets/**/*.spv.*.tmp
# Captures, of every kind. Machine-specific measurements of one run on one
# machine: large, stale the moment anything changes, and worthless to anyone
# who did not take them. Quote a number in the tracker instead of committing
# the file it came from.
#
# Chiara writes to <user root>/captures, and the user root is the exe directory
# by default — so running from the repo root leaves them here, the same way the
# logs above arrive. The build tree's copies are already covered by out/.
captures/

# RenderDoc captures (scripts/rdc-capture.sh) and the reports rdc-analyze.py
# writes beside them.
captures-rdc/
*.rdc

