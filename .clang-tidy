Checks: >
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-nodiscard,
  -modernize-use-trailing-return-type,
  -readability-avoid-const-params-in-decls,
  -readability-named-parameter,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -readability-uppercase-literal-suffix

CheckOptions:
  - key: modernize-use-default-member-init.UseAssignment
    value: true
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  # Only private/protected members carry the leading underscore; public data
  # members (plain aggregates like Transform, Vertex, BoundingSphere) use bare
  # names. Note the absence of a generic MemberPrefix rule: setting one would
  # force the underscore onto public members too.
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: _
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: _
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.ParameterCase
    value: camelBack

WarningsAsErrors: ''
HeaderFilterRegex: 'modules/.*\.hpp'
