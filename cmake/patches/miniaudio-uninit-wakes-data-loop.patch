diff --git a/miniaudio.h b/miniaudio.h
index c6d493e..dc87e41 100644
--- a/miniaudio.h
+++ b/miniaudio.h
@@ -44130,6 +44130,13 @@ MA_API void ma_device_uninit(ma_device* pDevice)
 
     /* Wake up the worker thread and wait for it to properly terminate. */
     if (!ma_context_is_backend_asynchronous(pDevice->pContext)) {
+        /*
+        A backend running its own data loop blocks in it until something wakes it. A stream whose
+        device has gone never does, so wake it here as ma_device_stop() does, or the wait never returns.
+        */
+        if (pDevice->pContext->callbacks.onDeviceDataLoopWakeup != NULL) {
+            pDevice->pContext->callbacks.onDeviceDataLoopWakeup(pDevice);
+        }
         ma_event_signal(&pDevice->wakeupEvent);
         ma_thread_wait(&pDevice->thread);
     }
